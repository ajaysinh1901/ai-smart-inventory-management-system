# Backend env vars
# Copy this file to `.env` (same folder) and fill in real values.
# NEVER commit your real `.env` — it should be ignored by git.

# Port the Express server listens on
PORT=5000

# development | production | test
NODE_ENV=development

# MongoDB connection string. For local dev, the default mongo runs on 27017.
MONGODB_URI=mongodb://127.0.0.1:27017/MERNDB

# Long random string used to sign JWTs. Use 32+ chars of randomness.
JWT_SECRET=replace-with-a-long-random-string-min-32-chars

# JWT expiry. Format follows `jsonwebtoken` (e.g. 7d, 12h, 30m).
JWT_EXPIRES_IN=7d

# Origin allowed by CORS (Vite dev server by default).
CLIENT_URL=http://localhost:5173

# Google Gemini API key — used by the AI service. Required for AI features.
GEMINI_API_KEY=your-google-gemini-api-key-here
